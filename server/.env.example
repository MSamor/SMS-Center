# Copy to server/.env. Use Node.js >=22.12; Node 24 LTS is recommended.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DATA_DIR=./data
ADMIN_USERNAME=admin
# Initial super administrator; created only when no account exists.
# Leave password empty to generate a random initial password (printed ONCE).
# A configured initial password must be 12..256 characters.
# First login MUST change the initial password before accessing any management data.
# Changing these values does NOT reset existing accounts.
ADMIN_PASSWORD=
# Optional 32-byte base64 encryption key. If empty, a key file is created in DATA_DIR.
# Back up the key AND the database together. Never replace this key for an existing database.
ENCRYPTION_KEY=
ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Production example: ADMIN_ORIGINS=https://sms.example.com
# Set to 1 ONLY behind one trusted reverse proxy, otherwise leave 0.
TRUST_PROXY=0
SESSION_HOURS=12
