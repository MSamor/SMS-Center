{
  "name": "sms-center",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "admin"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n server,admin -c blue,green \"npm run dev -w server\" \"npm run dev -w admin\"",
    "build": "node scripts/build.js",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "check": "npm test && npm run build",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write \"admin/**/*.{vue,js,css,json,html}\" \"server/**/*.{js,json}\" \"e2e/**/*.js\" \"scripts/*.js\" \"*.{js,json,yaml}\" \".github/workflows/*.yml\" \"docs/*.md\" README.md README-SMS.md",
    "format:check": "prettier --check \"admin/**/*.{vue,js,css,json,html}\" \"server/**/*.{js,json}\" \"e2e/**/*.js\" \"scripts/*.js\" \"*.{js,json,yaml}\" \".github/workflows/*.yml\" \"docs/*.md\" README.md README-SMS.md",
    "build:admin": "npm run build -w admin"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "overrides": {
    "shell-quote": "1.11.0"
  }
}
